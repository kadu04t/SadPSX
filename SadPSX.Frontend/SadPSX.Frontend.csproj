<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SadPSX.Frontend</RootNamespace>
    <AssemblyName>SadPSX</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SDL3-CS" Version="3.4.12.3" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.12.1"
                      Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="SDL3-CS.Linux" Version="3.4.12.1"
                      Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="SDL3-CS.MacOS" Version="3.4.12.1"
                      Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SadPSX.Core\SadPSX.Core.csproj" />
  </ItemGroup>

</Project>
